{
  "name": "better-spectrum-local",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "queues": {
    "producers": [
      { "binding": "JOBS", "queue": "better-spectrum-local-jobs" },
      { "binding": "DEAD_LETTER", "queue": "better-spectrum-local-failed" }
    ],
    "consumers": [
      { "queue": "better-spectrum-local-jobs", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 3, "max_concurrency": 2, "dead_letter_queue": "better-spectrum-local-failed" }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "student-manager",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
